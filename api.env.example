# MINCECRAFT uploader settings — TEMPLATE ONLY.
#
# The real file lives OUTSIDE this repo, on the Pi:
#     ~/.config/mincecraft/api.env        (chmod 600)
# install-uploader.sh copies this template there the first time. Then open
# it and replace the placeholder with the WRITE key.
#
# This repo is public. Never put the real key in here, in recipes.json, or in
# any other file in this folder. The READ key never goes on the Pi at all.

MINCECRAFT_API_URL=https://api-production-2ef9.up.railway.app/ingest
MINCECRAFT_API_KEY=PUT-THE-WRITE-KEY-HERE
MINCECRAFT_DEVICE=weigh-1
