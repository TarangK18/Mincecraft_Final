# systemd USER unit for the MINCECRAFT batch uploader.
# install-uploader.sh copies this to ~/.config/systemd/user/ with @HERE@
# replaced by the folder this repo lives in. Do not install it system-wide.
[Unit]
Description=MINCECRAFT batch uploader (batches.jsonl -> DOKI server)
Documentation=file://@HERE@/README.md
# Independent of the station: it starts, stops and fails on its own.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@HERE@
ExecStart=/usr/bin/python3 -u @HERE@/uploader.py
Restart=always
RestartSec=15
# Lower priority than the station's UI, always.
Nice=10

[Install]
WantedBy=default.target
